OPENCODEX_ADMIN_USERNAME=admin
OPENCODEX_ADMIN_PASSWORD=change-me

# ===== 数据库配置 =====
# 数据库提供程序: sqlite(默认) 或 postgres
OPENCODEX_DB_PROVIDER=sqlite

# SQLite 连接串(默认,使用 docker-compose-sqlite.yml 时)
OPENCODEX_DB_CONNECTION_STRING=Data Source=/app/logs/opencodex.db

# PostgreSQL 连接串(使用 docker-compose-pgsql.yml 时取消注释):
# OPENCODEX_DB_PROVIDER=postgres
# OPENCODEX_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=opencodex;Username=admin;Password=123456

# ===== Redis 缓存与共享状态（可选，留空则降级为纯进程内） =====
# 为空时禁用 Redis；启用后鉴权/路由/定价缓存走两级，亲和/容量/熔断走跨实例共享
OPENCODEX_REDIS_CONNECTION=
OPENCODEX_REDIS_PREFIX=opencodex
OPENCODEX_CACHE_DEFAULT_TTL_SECONDS=300

# ===== 运行时配置 =====
OPENCODEX_DEFAULT_TIMEOUT=120
OPENCODEX_ADMIN_COOKIE_DAYS=30
OPENCODEX_SECRET_KEY=change-me-session-secret
OPENCODEX_DATA_PROTECTION_KEYS_PATH=/app/logs/opencodex.keys
# Model catalog sync URL (leave empty to use built-in default)
OPENCODEX_MODEL_CATALOG_SYNC_URL=
TZ=Asia/Shanghai
