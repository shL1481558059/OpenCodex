OPENCODEX_ADMIN_USERNAME=admin
OPENCODEX_ADMIN_PASSWORD=change-me

# ===== 数据库配置 =====
# 数据库提供程序: sqlite(默认) 或 postgres
OPENCODEX_DB_PROVIDER=sqlite

# SQLite 连接串(默认,使用 docker-compose-sqlite.yml 时)
OPENCODEX_DB_CONNECTION_STRING=Data Source=/app/logs/opencodex.db

# PostgreSQL 连接串(使用 docker-compose-pgsql.yml 时取消注释):
# OPENCODEX_DB_PROVIDER=postgres
# OPENCODEX_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=opencodex;Username=admin;Password=123456

# ===== Redis 缓存与共享状态（可选，留空则降级为纯进程内） =====
# 为空时禁用 Redis；启用后鉴权/路由/定价缓存走两级，亲和/容量/熔断走跨实例共享
OPENCODEX_REDIS_CONNECTION=
OPENCODEX_REDIS_PREFIX=opencodex
OPENCODEX_CACHE_DEFAULT_TTL_SECONDS=300

# Native client continuation state: JSON is durable; Redis is a 24-hour sliding cache.
MultiAgent__StateDirectory=/app/logs/multi-agent-runs
MultiAgent__NativeClientState__RedisTtlHours=24
MultiAgent__NativeClientState__RedisMaxValueBytes=8388608

# ===== 运行时配置 =====
OPENCODEX_DEFAULT_TIMEOUT=120
OPENCODEX_ADMIN_COOKIE_DAYS=30
OPENCODEX_SECRET_KEY=change-me-session-secret
OPENCODEX_DATA_PROTECTION_KEYS_PATH=/app/logs/opencodex.keys
OPENCODEX_OCR_CACHE_DIR=ocr-cache
# Model catalog sync URL (leave empty to use built-in default)
OPENCODEX_MODEL_CATALOG_SYNC_URL=
TZ=Asia/Shanghai

# =====================================================================
# ===== 协议转换与容量预算（全部必填，缺任意一项进程直接启动失败） =====
# =====================================================================
# 这些值原本写在 protocol-conversion.parameters.json 中，现已全部迁到本文件。
# 读取规则：进程环境变量优先（容器可注入同名键），否则读取工作目录下的 .env。
# 路径可用 OPENCODEX_DOTENV_PATH 显式指定。
# 没有任何代码默认值，也不会自动截断/取大值；非法值直接报错。
# 修改后需重启进程才生效（进程内只读取一次）。

# --- 请求与暂存总预算 -------------------------------------------------
# 一个完整“解码后”请求的统一上限（字节）。HTTP、客户端 WebSocket 首条与后续消息、
# 还原历史后的逻辑请求、最终发给上游的请求，全部共用这个上限。
# 256 MiB = 268435456。它约束的是解码后的载荷，不是 chunked 传输编码的线上帧。
ProtocolConversion__MaxRequestBodyBytes=268435456

# --- 字符串与缓冲分片 -------------------------------------------------
# 拼接文本时的分段字符数，压缩大字符串的峰值内存。至少为 2。
ProtocolConversion__StringSegmentCharacters=4096

# 写盘/分片的通用块大小（字节）。多个缓冲与证据页以此为粒度。
ProtocolConversion__FlushBytes=16384

# 生成帧的缓存上限（字节）。
ProtocolConversion__GeneratedFrameCacheBytes=32768

# 文本捕获时一次复制的字符数，至少为 2。
ProtocolConversion__CaptureCopyCharacters=8192

# SSE 读取缓冲（字符数）。
ProtocolConversion__SseReadBufferCharacters=4096

# SSE 保留缓冲（字符数），用于回看已读片段。
ProtocolConversion__SseRetainedBufferCharacters=65536

# --- SSE / 事件预算 ---------------------------------------------------
# 发给客户端的“单个事件”上限（字节）。16 MiB = 16777216。
# 这是单事件上限，不是累计输出上限。
ProtocolConversion__SseMaxEventBytes=16777216

# 一次请求可捕获的完整流式响应总量上限（字节）。64 MiB = 67108864。
# 累计输出与最终响应都受它约束。
ProtocolConversion__SseMaxCaptureBytes=67108864

# 可捕获的条目数量上限（条）。
ProtocolConversion__SseMaxCaptureItems=4096

# 可捕获的字段数量上限（个），文本与二进制各自计数。
ProtocolConversion__SseMaxCaptureFields=8192

# 单轮可缓冲的总字节上限。32 MiB = 33554432。
ProtocolConversion__SseMaxBufferedRoundBytes=33554432

# 单轮可缓冲的帧数上限。
ProtocolConversion__SseMaxBufferedRoundFrames=65536

# 探测请求可读取的字节上限（16 MiB）。
ProtocolConversion__SseMaxProbeBytes=16777216

# 探测请求可读取的帧数上限。
ProtocolConversion__SseMaxProbeFrames=1024

# 与上游 Responses WebSocket 之间“单条消息”的上限（字节），收发共用。32 MiB。
# 注意：它只约束上游 WS 通道，不约束客户端到代理的请求大小。
ProtocolConversion__SseMaxWebSocketMessageBytes=33554432

# SSE 批量写出的大小上限（字节）。
ProtocolConversion__SseMaxBatchBytes=16384

# 批量写出的最大等待时间（毫秒）。
ProtocolConversion__SseMaxFlushDelayMilliseconds=10

# 事件队列的容量（事件个数）。
ProtocolConversion__SseMaxQueuedEvents=8

# 事件队列的容量（字节，1 MiB）。
ProtocolConversion__SseMaxQueuedBytes=1048576
